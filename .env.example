# Environment Variables: FieldWork Fixed App (Supabase & App Config)

# Supabase Project Connection
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Service Role Key (Backend Server Only - JANGAN diexpose ke client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# Backend Server Port
PORT=4000
NODE_ENV=development

# Storage Buckets Supabase
SUPABASE_STORAGE_BUCKET_PHOTOS=work-photos
SUPABASE_STORAGE_BUCKET_SIGNATURES=signatures
SUPABASE_STORAGE_BUCKET_DOCS=bap-documents
