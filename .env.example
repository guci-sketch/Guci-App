# ── Frontend (diekspos ke browser — HANYA nilai publik, jangan taruh rahasia di sini) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Backend (server-side saja) ──
# Postgres. Harus memakai role `postgres` (BYPASSRLS) — backend memfilter company_id sendiri di kode.
# Supabase: Project Settings → Database → Connection string ("Transaction pooler" untuk Vercel).
DATABASE_URL=postgresql://postgres:password@localhost:5432/fieldwork
# Opsional tetapi disarankan: CA PEM server DB agar sertifikat DIVERIFIKASI (boleh dengan \n literal).
DB_SSL_CA=

# Verifikasi token login (Supabase Auth). Isi SALAH SATU sesuai proyek Anda:
#   - HS256 (proyek lama): JWT Secret di Settings → API
#   - ES256/RS256 (signing keys baru): cukup SUPABASE_URL (JWKS dibaca otomatis)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=
# Wajib untuk membuat/menghapus akun pengguna dan untuk penyimpanan foto (Storage). JANGAN pernah diekspos ke browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=evidence-photos
# auto (Supabase bila terkonfigurasi) | local (disk ./uploads — hanya dev/tes) | supabase
STORAGE_DRIVER=
MAX_PHOTO_SIZE_MB=8

# Zona waktu bisnis: evaluasi "check-in terlambat", filter jam/tanggal, nomor surat
APP_TIMEZONE=Asia/Jakarta
# Batas usia aksi offline yang masih dipercaya saat sinkronisasi (jam)
OFFLINE_MAX_AGE_HOURS=24
# Batas permintaan per IP per menit untuk /api
RATE_LIMIT_PER_MIN=600

# Retensi otomatis (Vercel Cron memanggil GET /api/cron/purge-photos dengan Bearer CRON_SECRET)
CRON_SECRET=
PHOTO_RETENTION_MONTHS=2
LOCATION_RETENTION_DAYS=30

# Hanya untuk `npm run db:seed` (dev): true = buat akun login sungguhan di Supabase Auth
SEED_SUPABASE_AUTH=false
SEED_PASSWORD=
