# ============================================================
# FIELDWORK APP V2 — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# --- SERVER CONFIGURATION ---
PORT=3000
NODE_ENV=development

# --- SUPABASE PUBLIC (FRONTEND & BACKEND) ---
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- SUPABASE SERVER-SIDE (BACKEND & STORAGE) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Supabase JWT Secret untuk verifikasi token HS256 (Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your-jwt-secret-here

# --- POSTGRESQL DATABASE CONNECTION ---
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres
DB_SSL=true
# DB_SSL_CA=

# --- STORAGE DRIVER ---
# 'supabase' (produksi) atau 'local' (pengujian lokal)
STORAGE_DRIVER=local

# --- CRON & RETENTION JOB ---
CRON_SECRET=your-random-cron-secret-token

# --- SEED UTILITY (OPSIONAL) ---
SEED_SUPABASE_AUTH=false
SEED_PASSWORD=Demo12345!
