# Server
PORT=3000
NODE_ENV=development

# --- Database ---
# Local development: any local PostgreSQL 14+ instance.
DATABASE_URL=postgresql://fieldwork:fieldwork@localhost:5432/fieldwork_dev
#
# Production (Supabase): use the "Transaction" pooler connection string from
# Project Settings -> Database -> Connection string -> Transaction pooler
# (port 6543, not the direct 5432 connection — the pooler is what survives
# serverless functions opening/closing connections constantly on Vercel).
# It looks like:
# DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres
#
# TLS is auto-detected for any non-localhost host (including Supabase).
# Force it either way with DB_SSL=true / DB_SSL=false if needed.

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string-before-deploying
JWT_EXPIRES_IN=12h

# --- CORS ---
# Local: the Vite dev server. Production: your deployed frontend's Vercel URL.
# Comma-separate multiple allowed origins, e.g. for a preview + prod domain:
# CORS_ORIGIN=https://fieldwork.app,https://fieldwork-web.vercel.app
CORS_ORIGIN=http://localhost:5173

# --- Evidence photo storage ---
# Local development (no Supabase vars set below): saved to this local folder.
UPLOAD_DIR=./uploads
MAX_PHOTO_SIZE_MB=8
# Vercel Serverless Functions cap request bodies at ~4.5MB regardless of this
# setting — lower MAX_PHOTO_SIZE_MB to 4 (or compress harder client-side)
# before deploying if technicians are on high-resolution devices.

# --- Supabase (production) ---
# Leave these unset for local development — storage.ts automatically falls
# back to local disk when they're blank. Set both on Vercel to switch to
# Supabase Storage; get the values from Project Settings -> API.
# Use the SERVICE ROLE key here, never the anon/public key — this runs
# server-side only and needs full read/write access to a private bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket name to create in Supabase Storage before deploying (see README).
SUPABASE_STORAGE_BUCKET=evidence-photos
