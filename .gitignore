# ==============================================================================
# .gitignore: FielWork - Fixed App (Production & Standalone)
# Hanya menyertakan kode sumber utama, konfigurasi, skema SQL, dan test suite.
# ==============================================================================

# 1. Dependencies & Package Managers
node_modules/
.pnp
.pnp.js
package-lock.json.bak

# 2. Production Build Artifacts
dist/
dist-ssr/
build/
*.local

# 3. Environment Variables & Credentials (SANGAT SENSITIF)
.env
.env*.local
!.env.example

# 4. Logs, Runtime & Debuggers
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# 5. Editor, IDE & Agent Configs Non-Utama
.vscode/*
!.vscode/extensions.json
.idea/
.agents/
.claude/
.cursor/
.mcp.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# 6. Test Outputs, Coverage & Temporary Caches
coverage/
.nyc_output/
.turbo/
.cache/
.e2e/
*.tmp
*.temp
